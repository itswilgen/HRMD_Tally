* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore

# Windows setup scripts for the HRMD server PC (scripts/windows): Command
# Prompt and Windows Script Host want CRLF line endings.
scripts/windows/*.cmd text eol=crlf
scripts/windows/*.vbs text eol=crlf

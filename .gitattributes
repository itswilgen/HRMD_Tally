* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore

# Windows setup scripts for the HRMD server PC (scripts/windows): Command
# Prompt wants CRLF line endings, and Task Scheduler reads its task files as
# UTF-16, as it writes them itself.
scripts/windows/*.cmd text eol=crlf
scripts/windows/*.xml text eol=crlf working-tree-encoding=UTF-16LE-BOM
